PORT=3000
FRONTEND_URL=http://localhost:5500
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_ANON_KEY=supabase-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=supabase-service-role-key-placeholder

# Set to off on any instance that is not the single production one (a local
# run, a staging copy). The morning digest and the 15-minute reminders write
# reminder_sent_at and message real staff, so exactly one instance may run
# them. Defaults to on when unset.
SCHEDULED_NOTIFICATIONS=on

TELEGRAM_BOT_TOKEN=telegram-bot-token-placeholder
TELEGRAM_MANAGER_CHAT_ID=telegram-manager-chat-id-placeholder
TELEGRAM_MANAGER_CHAT_IDS=telegram-manager-chat-id-placeholder,second-manager-chat-id-placeholder
TELEGRAM_ORGANIZER_CHAT_IDS=telegram-organizer-chat-id-placeholder

HALYK_MERCHANT_ID=halyk-merchant-id-placeholder
HALYK_TERMINAL_ID=halyk-terminal-id-placeholder
HALYK_API_URL=https://halyk-api-placeholder.example
